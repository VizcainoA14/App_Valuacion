{
  "name": "app-valuacion-activos",
  "productName": "Valuación de Activos",
  "version": "0.1.0",
  "description": "Aplicación de escritorio para el proceso de valuación de activos de una E.S.E.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "Fundasaberes",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "typecheck": "tsc -p tsconfig.compartido.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "compat": "npx browserslist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rendimiento": "vitest run --config vitest.rendimiento.config.ts",
    "test:e2e": "playwright test",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "tsx scripts/migrar.ts",
    "db:triggers": "tsx scripts/generar-triggers.ts",
    "trazabilidad": "tsx scripts/trazabilidad.ts",
    "verificar:versiones": "tsx scripts/verificar-versiones.ts",
    "verificar:todo": "npm run typecheck && npm run lint && npm run boundaries && npm run test && npm run trazabilidad",
    "datos:prueba": "tsx scripts/generar-datos-prueba.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.9.1",
    "@playwright/test": "1.62.1",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.10",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.5.4",
    "browserslist": "4.28.8",
    "browserslist-to-esbuild": "2.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "0.31.10",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-compat": "7.0.2",
    "fast-check": "4.9.0",
    "lucide-react": "1.39.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-router": "7.18.3",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-no-unsupported-browser-features": "8.1.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  }
}
